{
  "name": "linkd",
  "private": true,
  "version": "0.1.0",
  "description": "Envía solicitudes de 'Solicitud sencilla' en LinkedIn usando tu CV y portfolio, y responde las preguntas de las empresas con Claude.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "setup": "npx playwright install chromium",
    "login": "node --env-file-if-exists=.env src/index.mjs login",
    "start": "node --env-file-if-exists=.env src/index.mjs",
    "prueba": "node --env-file-if-exists=.env src/index.mjs --prueba",
    "auto": "node --env-file-if-exists=.env src/index.mjs --auto"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "playwright": "^1.56.0",
    "unpdf": "^1.3.2"
  }
}
